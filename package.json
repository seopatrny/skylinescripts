{
  "name": "skylinescripts",
  "version": "1.0.0",
  "private": true,
  "description": "Skyline Speakers workshop: student tour scripts, admin run-of-show and river map.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
